# gitleaks configuration - project overrides for secret scanning.
# Copy this file to the repo root as `.gitleaks.toml` to activate.
#
# gitleaks uses the default ruleset unless `useDefault = false`.
# This template keeps the defaults and adds an allowlist for common false
# positives in gcli smoke fixtures, example files, and local runtime state.

title = "gitleaks config for gcli pack"

[extend]
useDefault = true

[allowlist]
description = "Project-specific allowlist for fixtures, examples, and local runtime state"

paths = [
  '''(^|/)smoke/.*''',
  '''(^|/)tmp/.*''',
  '''(^|/)\.geminicode/.*''',
  '''(^|/)examples/.*''',
  '''(^|/)\.gcli/.*''',
  '''(^|/)host/.*''',
  '''\.example$''',
]

regexes = [
  '''AIza[0-9A-Za-z_\-]{35}''',
  '''chrome-extension://[a-z]{32}/?''',
  '''"extension_id"\s*:\s*"[a-z]{32}"''',
  '''manifest\.json\.example''',
]

# Commit SHAs to skip entirely. Useful after a one-time approved commit.
# commits = [
#   "1a2b3c4d5e6f7g8h9i0j",
# ]
