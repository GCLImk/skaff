# Ratchet Gate - GitHub Actions workflow template
#
# Copy this file to .github/workflows/ratchet-gate.yml at the repo root.
# Runs on every pull_request and every push to main.
#
# Gates on parse_check, lint, test_coverage, doc_quality, and secrets.
# Does NOT re-implement the full ratchet agent scoring - that is
# agent-owned. This workflow blocks PRs on objective, deterministic
# regressions that can be measured without LLM judgement.
#
# Human review stays required. This workflow does not enable auto-merge.
#
# Dependencies:
#   - dotnet 9.x (installed by actions/setup-dotnet@v4)
#   - gitleaks (installed by gitleaks/gitleaks-action@v2)
#   - python3 (pre-installed on ubuntu-latest; install manually on self-hosted runners)

name: ratchet-gate

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

jobs:
  build-and-test:
    name: Build, test, format
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0  # Full history so baselines.jsonl is accessible

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '9.0.x'

      # parse_check - dotnet build must succeed
      - name: Build
        run: dotnet build --nologo --verbosity minimal

      # test_coverage regression gate - tests pass and coverage present
      - name: Test
        run: dotnet test --nologo --verbosity minimal --no-build

      # lint floor - dotnet format must pass
      - name: Format check
        run: dotnet format --verify-no-changes --verbosity minimal

      # doc_quality floor - zero CS1591 warnings on modified projects
      - name: CS1591 warnings
        run: |
          set -e
          warnings=$(dotnet build --nologo /warnaserror:CS1591 2>&1 | grep -c "CS1591" || true)
          if [ "$warnings" -gt 0 ]; then
            echo "::error::CS1591 missing-doc warnings found. Add XML docs before merging."
            exit 1
          fi

  secret-scan:
    name: Secret scan (gitleaks)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # GITLEAKS_LICENSE only required for organizations, not personal accounts
          GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}

  ratchet-baseline:
    name: Ratchet baseline regression
    runs-on: ubuntu-latest
    needs: build-and-test
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Compare composite against PR base
        run: |
          set -e
          # This job is a sanity check, not a full re-score.
          # The ratchet agent writes baselines.jsonl on merge; this job
          # refuses the PR if the latest baseline's composite is below
          # the project's composite floor.
          baseline_file="do-work/ratchet/baselines.jsonl"
          if [ ! -s "$baseline_file" ]; then
            echo "No ratchet baselines yet. Skipping regression gate."
            exit 0
          fi
          latest=$(tail -1 "$baseline_file")
          composite=$(echo "$latest" | python3 -c "import json,sys;print(json.load(sys.stdin)['composite'])")
          # Project floor - edit per project expectations, default 0.75.
          floor="${RATCHET_COMPOSITE_FLOOR:-0.75}"
          if python3 -c "import sys;sys.exit(0 if $composite >= $floor else 1)"; then
            echo "Latest baseline composite $composite >= floor $floor"
          else
            echo "::error::Latest baseline composite $composite is below floor $floor"
            exit 1
          fi
